{
	"name": "winstead-family",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "oxlint",
		"preview": "npm run build && vite preview",
		"deploy": "npm run build && wrangler deploy --keep-vars",
		"cf-typegen": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply winstead-family --local",
		"db:migrate:remote": "wrangler d1 migrations apply winstead-family --remote"
	},
	"dependencies": {
		"@fontsource/atkinson-hyperlegible": "^5.2.8",
		"@fontsource/inter": "^5.2.8",
		"@fontsource/lexend": "^5.2.11",
		"@fontsource/nunito": "^5.2.7",
		"@fontsource/opendyslexic": "^5.2.5",
		"@fontsource/source-serif-4": "^5.2.9",
		"hono": "^4.11.3",
		"jose": "^6.1.3",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router-dom": "^7.9.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.15.2",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"oxlint": "^1.79.0",
		"typescript": "~6.0.2",
		"vite": "^8.2.2",
		"wrangler": "^4.131.0"
	}
}
